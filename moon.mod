name = "moonbitstack/moonfont"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfont"

license = "Apache-2.0"

keywords = [
  "font",
  "fonts",
  "truetype",
  "opentype",
  "sfnt",
  "ttc",
  "glyph",
  "outline",
  "rasterisation",
  "coverage",
  "metrics",
  "cmap",
  "glyf",
  "text",
  "typography",
  "moonbit",
]

description = "Font parsing and glyph rasterisation for MoonBit."

source = "src"

import {
  "moonbitstack/moonzip@0.4.1",
}
